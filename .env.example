# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WEATHER_API_KEY: Required for weather-aware style tips.
# Uses OpenWeatherMap current weather data.
WEATHER_API_KEY="MY_WEATHER_API_KEY"

# VITE_API_BASE_URL: Optional for production when the frontend and backend
# are deployed as separate services. Example: https://your-backend.onrender.com
VITE_API_BASE_URL=""

# CORS_ORIGIN: Optional comma-separated frontend origins allowed by the backend.
# Example: https://your-frontend.onrender.com
CORS_ORIGIN=""
